{
  "name": "encuesta-hh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extrae estructura y respuestas de un formulario Jotform y genera una web estática equivalente",
  "scripts": {
    "fetch": "node scripts/fetch-jotform.mjs",
    "fetch:refresh": "node scripts/fetch-jotform.mjs --refresh",
    "fetch-supabase": "node scripts/fetch-supabase.mjs",
    "recalc-local": "node scripts/recalc-local.mjs",
    "generate": "node scripts/generate-site.mjs",
    "build": "node scripts/fetch-jotform.mjs && node scripts/generate-site.mjs",
    "export-supabase": "node scripts/export-supabase.mjs",
    "dashboard": "node scripts/build-dashboard.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
