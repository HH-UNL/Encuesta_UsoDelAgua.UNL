# Copia este archivo a .env y rellena tus datos

# --- Jotform (solo para leer estructura/respuestas: npm run fetch) ---
# Obtén la API key en: https://www.jotform.com/myaccount/api/
# El ID del formulario aparece en la URL: https://form.jotform.com/250000000000000 -> 250000000000000
JOTFORM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JOTFORM_FORM_ID=000000000000000
# Opcional: enlace al formulario original (aparece en la web generada)
JOTFORM_FORM_URL=https://form.jotform.com/000000000000000

# --- Supabase (destino de los envíos de la web generada) ---
# URL del proyecto: Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Anon / publishable key (pública por diseño; va embebida en la web generada).
# Requiere la política de INSERT de policy-anon-insert.sql activa en la tabla.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.rellena_aqui
